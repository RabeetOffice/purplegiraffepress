# Purple Giraffe Press - URL handling
#
# Clean, extension-less URLs on the LIVE site (e.g. /about-us, /blogs/<slug>).
# On localhost the redirects below are skipped, so .php URLs keep working for
# local editing. The internal rewrite that serves /page from /page.php runs in
# every environment, so clean links work locally too if you use them.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- LIVE ONLY: 301-redirect .php requests to their clean URL ---------------
  # Skipped on localhost / 127.0.0.1 so local navigation and editing keep .php.

  # /index.php (or "/") -> /
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
  RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  # /anything.php -> /anything   (and /dir/page.php -> /dir/page)
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # --- ALL ENVIRONMENTS: serve a clean URL from its .php file -----------------
  # Only when the request is not already a real file/dir and the .php exists.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

# ---------------------------------------------------------------------------
# PERFORMANCE
# ---------------------------------------------------------------------------

# Gzip compression for text-based responses.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
</IfModule>

# Long-lived caching for static assets (CSS/JS are versioned with ?v=, so safe).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType text/javascript           "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/gif                 "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|png|jpe?g|gif|ico|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Friendly 404 (optional): uncomment if you add a 404.php
# ErrorDocument 404 /404.php
